<?xml version="1.0" encoding="utf-8"?>
<!--
    File: switch_track_color.xml
    Purpose: Color state list for switch track colors.
            Changes color based on checked state: blue when checked, gray when unchecked.
    Author: Awais Imtiaz
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#00B4D8" android:state_checked="true"/>
    <item android:color="#30363D" android:state_checked="false"/>
</selector>
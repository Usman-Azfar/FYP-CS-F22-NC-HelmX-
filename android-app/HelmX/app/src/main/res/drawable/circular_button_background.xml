<?xml version="1.0" encoding="utf-8"?>
<!--
    File: circular_button_background.xml
    Purpose: Circular button background with border stroke.
            Creates a perfect circle shape for floating action buttons and icon buttons.
    Author: Awais Imtiaz
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#161B22"/>
    <stroke
        android:width="1dp"
        android:color="#30363D"/>
</shape>